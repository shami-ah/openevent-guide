# OpenEvent Guide server configuration

# ── Required ──────────────────────────────────────────────────────
# OpenAI API key, used by the chat brain and to mint voice tokens.
OPENAI_API_KEY=sk-...

# ── Server ────────────────────────────────────────────────────────
PORT=3847

# Interface to bind. Defaults to loopback, so an unconfigured server is not
# reachable from other machines. Set 0.0.0.0 (with a token) to serve publicly.
GUIDE_HOST=127.0.0.1

# ── Security ──────────────────────────────────────────────────────
# The server runs "local" (no token needed, any CORS origin) only when it binds
# loopback, NODE_ENV is not production and GUIDE_TRUST_PROXY is 0. Otherwise it
# refuses to start without GUIDE_API_TOKEN. A public deployment should also set
# NODE_ENV=production: a loopback server behind a same-host proxy is still
# public, and that is the one case the server cannot detect on its own.

# Shared secret required on every /api/* request. Leave unset for local
# development only.
GUIDE_API_TOKEN=

# Comma-separated CORS allowlist. When empty, local development allows any
# origin and every other deployment denies all cross-origin requests. The
# same-origin /guide/ proxy and the extension do not need CORS, so leaving it
# empty is the safe default. e.g. https://app.test.openevent.io
GUIDE_ALLOWED_ORIGINS=

# How many reverse proxies in front of this server append to X-Forwarded-For.
# 0 ignores the header and rate limits on the TCP peer. Behind OpenEvent's
# /guide/ proxy plus this host's own reverse proxy, use 2.
GUIDE_TRUST_PROXY=0

# Requests per minute per client address. Default 30.
GUIDE_RATE_LIMIT=30

# ── Models ────────────────────────────────────────────────────────
GUIDE_MODEL=gpt-4o

# Voice. Both endpoints are overridable because OpenAI has moved them before:
# the GA Realtime API uses /v1/realtime/client_secrets and /v1/realtime/calls.
# Change these rather than editing code. See docs/voice-call-fix.md.
GUIDE_REALTIME_MODEL=gpt-4o-realtime-preview
GUIDE_REALTIME_VOICE=verse
GUIDE_REALTIME_SESSION_URL=https://api.openai.com/v1/realtime/sessions
GUIDE_REALTIME_SDP_URL=https://api.openai.com/v1/realtime
