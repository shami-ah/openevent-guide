{
  "name": "openevent-guide",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered interactive onboarding guide for OpenEvent",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "npm run build:server && npm run build:widget && npm run build:agent",
    "build:server": "tsup src/server/index.ts --format esm --out-dir dist/server",
    "build:widget": "vite build --config vite.widget.config.ts",
    "build:agent": "vite build --config vite.agent.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.7.0",
    "openai": "^7.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
