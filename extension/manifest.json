{
  "manifest_version": 3,
  "name": "OpenEvent Guide",
  "version": "2.0.0",
  "description": "AI onboarding assistant for OpenEvent",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://app.openevent.io/*",
    "https://app.test.openevent.io/*",
    "https://app.play.openevent.io/*",
    "https://ahtesham.dev.wadwarehouse.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.openevent.io/*",
        "https://app.test.openevent.io/*",
        "https://app.play.openevent.io/*"
      ],
      "js": ["loader.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
